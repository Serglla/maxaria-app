# Copiá este archivo a `.env` y poné valores reales
# (no subas el .env a Git ni a GitHub)

# Puerto en el que corre el server
PORT=3000

# Frase larga y secreta para firmar cookies de sesión
# Generá una nueva con:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=cambiar-esto-por-algo-largo-y-aleatorio

# Número de WhatsApp donde se envían los pedidos (formato internacional sin +, ej: 549...)
WHATSAPP_NUMBER=5493442000000

# Modo de ejecución
NODE_ENV=development

# Ruta a la base SQLite.
# En producción debe apuntar a un volumen persistente; si no se define,
# boot.js intenta detectar el volumen automáticamente (/data, /var/data, etc.)
# o cae al fallback local data/maxaria.db (efímero en hosting con filesystem volátil).
# DB_PATH=/data/maxaria.db

# Ruta al Excel de precios (opcional).
# Si no se define, boot.js y seed.js lo buscan en data/precios_maxaria.xlsx
# y en el directorio padre del proyecto.
# EXCEL_PATH=/data/precios_maxaria.xlsx

# Cuántos backups automáticos conservar (default 7).
# BACKUP_KEEP=7

# ¿Crear la base automáticamente si no existe al arrancar?
# - false (default en producción): si la DB no existe, el server aborta con un
#   error claro. Previene re-seedear accidentalmente por un volumen mal montado.
# - true (default en desarrollo): crea la base al primer arranque.
#   Si hay Excel disponible, corre el seed completo con productos y usuarios demo.
#   Si no hay Excel, crea una base vacía con un usuario admin y password aleatoria
#   que se imprime una sola vez en los logs de arranque.
# Usá SEED_ON_EMPTY=true solo en el PRIMER arranque de una instancia nueva.
# SEED_ON_EMPTY=false
