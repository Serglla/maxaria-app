# Copiá este archivo a `.env` y poné valores reales
# (no subas el .env a Git ni a GitHub)

# Puerto en el que corre el server
PORT=3000

# Frase larga y secreta para firmar cookies de sesión
# Generá una nueva con:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=cambiar-esto-por-algo-largo-y-aleatorio

# Número de WhatsApp donde se envían los pedidos (formato internacional sin +, ej: 549...)
WHATSAPP_NUMBER=5493442000000

# Modo de ejecución
NODE_ENV=development
